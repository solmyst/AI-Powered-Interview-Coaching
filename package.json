{
  "name": "interviewace",
  "private": true,
  "version": "1.0.0",
  "description": "AI-Powered Interview Coaching Platform",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:client": "vite",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test:e2e": "playwright test",
    "test:live": "node tests/live-smoke.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "prettier": "^3.9.10",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
