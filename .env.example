PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/interviewace.db
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
AI_TIMEOUT_MS=120000
DAILY_INTERVIEW_LIMIT=5
DAILY_SPEECH_LIMIT=300
# Comma-separated owner/testing emails with no daily caps. Register the account FIRST, then restart:
# listed emails are pinned to the account that already owns them at startup (no email verification exists).
UNLIMITED_EMAILS=
# Comma-separated emails allowed to create a company for screening (pilot). Unlimited accounts can too.
SCREENING_EMAILS=
# Voice calls one invited candidate may use (charged to the company).
CANDIDATE_SPEECH_LIMIT=150

AI_PROVIDER=ollama
# Optional hosted provider: AI_PROVIDER=nvidia
# Hosted NVIDIA is remote inference; use Ollama above for a model local to the VM.
NVIDIA_API_KEY=
NVIDIA_MODEL=
# Optional separate model for background scoring; interactive questions and relevance checks keep NVIDIA_MODEL.
# Leave blank until the alternative passes the same human-labelled calibration set.
NVIDIA_ASSESSMENT_MODEL=
# Any OpenAI-compatible endpoint can replace NVIDIA's (default https://integrate.api.nvidia.com/v1).
NVIDIA_BASE_URL=
# Requests per minute this server sends to the model. NVIDIA's hosted API allows about 40 (measured); the default
# is 35. Raise it with a paid plan. Calls above the budget wait their turn instead of failing.
AI_RPM=
# Full judge panel size, 3 (default) or 5. Partial panels remain retryable instead of publishing a score.
SCORING_SAMPLES=

# Required for English/Hindi spoken-answer transcription. Keep this server-side.
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_MODEL=universal-3-5-pro

# Optional consistent interviewer voice. Keep the key server-side.
SARVAM_API_KEY=
SARVAM_MODEL=bulbul:v4-flash
SARVAM_VOICE=aarti_hi_customer
